; Villain hideout - sneaking through the corridors, D minor. Original composition, CC0-1.0.
#title Behind Locked Doors
#tempo 120
#time 4/4
#key D minor
#inst 1 duty=0 env=11,-2 rel=-1 vib=30,10,6
#inst 2 duty=3 env=4,0 rel=-2
#inst 3 wave=6 env=12,0
#def pM o4 g2 e2
#def pm o4 g2 d+2
#def pM2 o4 g4 e4
#def pd o4 f+2 d+2
#def os o2 c8 r8 g8 c8 r8 g8 f8 g8
#def os2 o2 c8 r8 g8 c8
#def ma o4 d8 r8 f8 r8 e8 f8 a4 | o4 a8 r8 g8 f8 e8 c+8 d4 | o4 b-8 r8 a8 r8 g8 f8 d4 | o4 e4 c+4 a4 r4 | o5 d8 r8 c8 r8 o4 a8 b-8 a4 | o4 g8 r8 b-8 r8 o5 d8 c8 o4 b-4 | o4 f4 d4 e4 c+4 | o4 d2 r2 |
#def mb o4 g8 a8 b-8 r8 o5 d4 c+8 d8 | o5 f4 e8 d8 o4 a4 r4 | o4 g8 a8 b-8 r8 o5 d4 e8 f8 | o5 e2 c+4 r4 | o5 d8 r8 o4 b-8 r8 f8 r8 b-4 | o4 g8 r8 b-8 r8 o5 d8 r8 g4 | o4 e4 g4 b-4 g4 | o4 a4 o5 c+4 e4 o4 a4 |
#def ha k2{pm} | k2{pm} | k-2{pM} | k-3{pM} | k2{pm} | k-5{pm} | k-2{pM2} k-3{pM2} | k2{pm} | k0
#def hb k-5{pm} | k2{pm} | k-5{pm} | k-3{pM} | k-2{pM} | k-5{pm} | k4{pd} | k-3{pM} | k0
#def ba k2{os} | k2{os} | k10{os} | k9{os} | k2{os} | k7{os} | k10{os2} k9{os2} | k2{os} | k0
#def bb k7{os} | k2{os} | k7{os} | k9{os} | k10{os} | k7{os} | o2 e8 r8 b-8 e8 r8 b-8 a8 b-8 | k9{os} | k0

A @1 q6 $ {ma} {mb} {ma}
B @2 $ {ha} {hb} {ha}
C @3 q7 $ {ba} {bb} {ba}
D v8 $ [[K8 H8 R8 H8 K8 K8 R8 H8]7 K8 H8 R8 H8 R16 R16 R8 X8 X8]3
