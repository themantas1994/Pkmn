#title Magma Run
#tempo 152
#time 4/4
#key G phrygian
#inst 1 duty=2 env=12,-2 rel=-2 vib=10,18,6.5
#inst 2 duty=0 env=9,-5 rel=-1
#inst 3 wave=7 env=14,0
#def Pw o4 c16 g16 > c16 < g16 c16 g16 > c16 g16 <
#def Bd o2 [c8 c16 c16]4
#def Dr K8 H8 S8 H8 K8 K8 S8 H8
#def Dc C8 H8 S8 H8 K8 K8 S8 H8
#def mA g4 g8 a-8 g4 d4 | b-4. g8 > d4 < b-4 | a-4 > c4 e-4 a-4 < | > g4 e-4 < c4 e-4 | g8 g8 a-8 g8 b-4 d4 | > d4. e-8 d4 < b-4 | a-4 > c4 f4 e-4 < | c4 e-4 g4 a-4 |
#def mB e-4 g4 b-4 > e-4 < | > g4. f8 e-4 d4 < | a-4 > c4 f4 a-4 < | > a-8 g8 f8 e-8 d4 c4 < | c4 e-4 g4 e-4 | g4. > c8 e-2 < | > c4. < a-8 e-4 c4 | d4 g4 b-4 > d4 < |
#def cA k7{Pw}{Pw} | k7{Pw}{Pw} | k8{Pw}{Pw} | k8{Pw}{Pw} | k7{Pw}{Pw} | k7{Pw}{Pw} | k5{Pw}{Pw} | k8{Pw}{Pw} |
#def cB k3{Pw}{Pw} | k3{Pw}{Pw} | k5{Pw}{Pw} | k5{Pw}{Pw} | k0{Pw}{Pw} | k0{Pw}{Pw} | k8{Pw}{Pw} | k7{Pw}{Pw} |
#def bA k7{Bd} | k7{Bd} | k8{Bd} | k8{Bd} | k7{Bd} | k7{Bd} | k5{Bd} | k8{Bd} |
#def bB k3{Bd} | k3{Bd} | k5{Bd} | k5{Bd} | k0{Bd} | k0{Bd} | k8{Bd} | k7{Bd} |

A @1 o5 $ {mA} {mB} {mA}
B @2 $ {cA} {cB} {cA} k0
C @3 $ {bA} {bB} {bA} k0
D v10 $ {Dc} [{Dr}]7 {Dc} [{Dr}]7 {Dc} [{Dr}]7
