<?xml version="1.0" encoding="utf-8"?>
<!--
  Same decision as backup_rules.xml for Android 12+ (android:dataExtractionRules), for cloud backup and device-to-device
  transfer alike: saves and options yes, the in-flight save.json.tmp never, and imported/ (official sprites/cries) is simply not in the include list.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves" />
        <exclude domain="file" path="saves/save.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saves" />
        <exclude domain="file" path="saves/save.json.tmp" />
    </device-transfer>
</data-extraction-rules>
